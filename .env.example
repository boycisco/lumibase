# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=

# Blockchain RPC
BASE_SEPOLIA_RPC=
BASE_MAINNET_RPC=

# Application
API_SECRET=

# Master encryption key for webhook signing secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for POST /api/v1/webhooks and for the worker to sign deliveries.
WEBHOOK_SECRET=

# Worker
# How often the webhook delivery worker polls the deliveries table.
# Defaults to 1000ms. Lower values make local demo/development faster.
WORKER_INTERVAL_MS=