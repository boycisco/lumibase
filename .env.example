# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=

# Blockchain RPC
BASE_SEPOLIA_RPC=
BASE_MAINNET_RPC=

# Application
API_SECRET=

# Master encryption key for webhook signing secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for POST /api/v1/webhooks and for the worker to sign deliveries.
WEBHOOK_SECRET=

# Worker
# How often the webhook delivery worker polls the deliveries table.
# Defaults to 1000ms. Lower values make local demo/development faster.
WORKER_INTERVAL_MS=

# Demo (apps/demo)
# Base URL of the running LumiBase API. The demo server calls this
# server-to-server; the browser never sees it.
LUMIBASE_API_URL=http://localhost:3000

# Merchant wallet that receives USDC payments in the demo. Must be a valid
# EVM address (checksummed or lowercase). This is the "recipient" of every
# payment the demo creates.
DEMO_RECIPIENT=

# HTTP port for the demo server (apps/demo). Must match the `-p 4000` flag
# in apps/demo/package.json dev script unless you also change that script.
DEMO_PORT=4000